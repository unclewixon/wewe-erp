# Copy to .env on the droplet and set a strong DB_PASSWORD. NEVER commit .env.
DB_USER=wewe
DB_PASSWORD=change-me-to-something-strong
DB_NAME=wewe_erp
WEB_PORT=80
# Plain HTTP on the droplet IP for now → cookies non-secure, no CORS origin pin.
COOKIE_SECURE=0
WEB_ORIGIN=
# Seed the demo org (11 users, sample data) on first boot. Set 0 for a clean production DB.
SEED_DEMO=1

# ---------- Production: HTTPS (see docker-compose.tls.yml + deploy/Caddyfile) ----------
# When fronting with Caddy for TLS: set WEB_PORT=8080 (Caddy takes 80/443), COOKIE_SECURE=1,
# WEB_ORIGIN=https://your-domain, and DOMAIN for the cert.
# DOMAIN=erp.weweng.org

# ---------- Email (SMTP) — leave unset to keep the dev .eml file outbox ----------
# SMTP_HOST=smtp.gmail.com        # or smtp.office365.com
# SMTP_PORT=587                   # 465 with SMTP_SECURE=1
# SMTP_SECURE=0
# SMTP_USER=erp@wewe.org
# SMTP_PASS=app-password-or-mailbox-password
# MAIL_FROM=WEWE ERP <erp@wewe.org>

# ---------- QuickBooks Online (live) — leave unset to stay in sandbox mode ----------
# Create an Intuit app at https://developer.intuit.com, add the redirect URI below.
# QBO_CLIENT_ID=
# QBO_CLIENT_SECRET=
# QBO_REDIRECT_URI=https://erp.weweng.org/v1/qb/callback
# QBO_ENV=sandbox                 # set to 'production' for the live QuickBooks company

# ---------- Clean-org bootstrap (scripts/bootstrap-prod.ts) — only when SEED_DEMO=0 ----------
# ADMIN_EMAIL=admin@wewe.org
# ADMIN_PASSWORD=set-a-strong-one
# ADMIN_NAME=System Administrator
